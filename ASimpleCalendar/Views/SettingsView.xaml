<UserControl x:Class="ASimpleCalendar.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xml:lang="ru-RU">
    <Grid Margin="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock Text="Настройки" FontSize="22" FontWeight="SemiBold" />

            <TextBlock Text="Оформление" FontWeight="SemiBold" Margin="0,28,0,0" />
            <Border CornerRadius="8"
                    Padding="16"
                    Margin="0,10,0,0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <ComboBox ItemsSource="{Binding ThemeChoices}"
                          SelectedItem="{Binding SelectedThemeOption}"
                          DisplayMemberPath="Name" />
            </Border>

            <TextBlock Text="Акцентный цвет" FontWeight="SemiBold" Margin="0,28,0,0" />
            <Border CornerRadius="8"
                    Padding="16"
                    Margin="0,10,0,0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <ListBox ItemsSource="{Binding AccentChoices}"
                         SelectedItem="{Binding SelectedAccent}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="72" ToolTip="{Binding Name}">
                                <Border Width="28"
                                        Height="28"
                                        CornerRadius="14"
                                        HorizontalAlignment="Center"
                                        Background="{Binding Hex, Converter={StaticResource StringToBrush}}"
                                        BorderBrush="{DynamicResource ControlFillColorSecondaryBrush}"
                                        BorderThickness="1" />
                                <TextBlock Text="{Binding Name}"
                                           FontSize="10"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <TextBlock Text="Система" FontWeight="SemiBold" Margin="0,28,0,0" />
            <Border CornerRadius="8"
                    Padding="16"
                    Margin="0,10,0,0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <ui:ToggleSwitch Content="Запускать при входе в Windows" IsChecked="{Binding AutoStartEnabled}" />
            </Border>

            <TextBlock Text="Горячие клавиши" FontWeight="SemiBold" Margin="0,28,0,0" />
            <Border CornerRadius="8"
                    Padding="16"
                    Margin="0,10,0,0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Ctrl+Alt+C — показать окно приложения" />
                    <TextBlock Text="Ctrl+Alt+N — новая заметка" Margin="0,4,0,0" />
                    <TextBlock Text="Ctrl+Alt+T — новое напоминание" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Виджеты на рабочий стол" FontWeight="SemiBold" Margin="0,28,0,0" />
            <Border CornerRadius="8"
                    Padding="16"
                    Margin="0,10,0,0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <ui:ToggleSwitch Content="Часы" IsChecked="{Binding ClockEnabled}" />
                    <ui:ToggleSwitch Content="Мини-календарь" Margin="0,14,0,0" IsChecked="{Binding CalendarEnabled}" />
                    <ui:ToggleSwitch Content="Задачи на сегодня" Margin="0,14,0,0" IsChecked="{Binding TasksEnabled}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Настройки виджетов" FontWeight="SemiBold" Margin="0,28,0,0" />
            <Border CornerRadius="8"
                    Padding="16"
                    Margin="0,10,0,0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Прозрачность" />
                    <Slider Minimum="0.5"
                            Maximum="1.0"
                            Margin="0,4,0,0"
                            Value="{Binding WidgetOpacity, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Масштаб" Margin="0,16,0,0" />
                    <Slider Minimum="0.6"
                            Maximum="1.4"
                            Margin="0,4,0,0"
                            Value="{Binding WidgetScale, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:ToggleSwitch Content="Поверх всех окон" Margin="0,16,0,0" IsChecked="{Binding WidgetTopmost}" />
                    <ui:ToggleSwitch Content="Закрепить позицию" Margin="0,14,0,0" IsChecked="{Binding WidgetLocked}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Категории событий" FontWeight="SemiBold" Margin="0,28,0,0" />
            <Border CornerRadius="8"
                    Padding="16"
                    Margin="0,10,0,0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <ListBox x:Name="CategoryList"
                             ItemsSource="{Binding Categories}"
                             MaxHeight="160"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Border Width="12"
                                            Height="12"
                                            CornerRadius="6"
                                            Background="{Binding Color, Converter={StaticResource StringToBrush}}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ui:Button Content="Добавить" Click="AddCategory_Click" />
                        <ui:Button Content="Удалить"
                                   Appearance="Danger"
                                   Margin="8,0,0,0"
                                   Click="RemoveCategory_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Данные" FontWeight="SemiBold" Margin="0,28,0,0" />
            <Border CornerRadius="8"
                    Padding="16"
                    Margin="0,10,0,0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <ui:Button Content="Экспорт в JSON"
                               HorizontalAlignment="Left"
                               Click="Export_Click" />
                    <ui:Button Content="Импорт из JSON"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Left"
                               Click="Import_Click" />
                    <ui:Button Content="Создать резервную копию"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Left"
                               Click="Backup_Click" />
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
