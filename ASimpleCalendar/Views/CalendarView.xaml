<UserControl x:Class="ASimpleCalendar.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <ui:SymbolIcon Symbol="Calendar24" FontSize="48" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="Календарь"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Margin="0,16,0,0"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Здесь появится календарь с событиями: день, неделя, месяц"
                       FontSize="14"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
