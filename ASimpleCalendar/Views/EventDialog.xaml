<Window x:Class="ASimpleCalendar.Views.EventDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Событие"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        xml:lang="ru-RU"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="Название" FontWeight="SemiBold" />
        <ui:TextBox x:Name="TitleBox" Margin="0,6,0,0" />

        <TextBlock Text="Описание" FontWeight="SemiBold" Margin="0,16,0,0" />
        <ui:TextBox x:Name="DescriptionBox" Margin="0,6,0,0" Height="70" AcceptsReturn="True" TextWrapping="Wrap" />

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Дата" FontWeight="SemiBold" />
                <DatePicker x:Name="DatePicker" Margin="0,6,0,0" />

                <TextBlock Text="Время начала" FontWeight="SemiBold" Margin="0,14,0,0" />
                <ui:TextBox x:Name="StartTimeBox" Margin="0,6,0,0" Text="09:00" />

                <TextBlock Text="Время окончания" FontWeight="SemiBold" Margin="0,14,0,0" />
                <ui:TextBox x:Name="EndTimeBox" Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                <ui:ToggleSwitch x:Name="AllDayBox" Content="Весь день" />
                <TextBlock Text="Категория" FontWeight="SemiBold" Margin="0,18,0,0" />
                <ComboBox x:Name="CategoryBox" Margin="0,6,0,0" DisplayMemberPath="Name" />
                <TextBlock Text="Повтор" FontWeight="SemiBold" Margin="0,18,0,0" />
                <ComboBox x:Name="RepeatBox" Margin="0,6,0,0" DisplayMemberPath="Name" />
                <TextBlock Text="Повторять до" FontWeight="SemiBold" Margin="0,14,0,0" />
                <DatePicker x:Name="RepeatUntilPicker" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <ui:Button Content="Отмена" Margin="0,0,8,0" Click="Cancel_Click" />
            <ui:Button Content="Сохранить" Appearance="Primary" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
