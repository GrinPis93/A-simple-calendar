<Window x:Class="ASimpleCalendar.Views.CategoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Категория"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        xml:lang="ru-RU"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <Window.Resources>
        <DataTemplate x:Key="ColorItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Border Width="14"
                        Height="14"
                        CornerRadius="7"
                        Background="{Binding Converter={StaticResource StringToBrush}}"
                        VerticalAlignment="Center" />
                <TextBlock Text="{Binding}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="Название" FontWeight="SemiBold" />
        <ui:TextBox x:Name="NameBox" Margin="0,6,0,0" />

        <TextBlock Text="Цвет" FontWeight="SemiBold" Margin="0,16,0,0" />
        <ComboBox x:Name="ColorBox"
                  Margin="0,6,0,0"
                  ItemTemplate="{StaticResource ColorItemTemplate}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <ui:Button Content="Отмена" Margin="0,0,8,0" Click="Cancel_Click" />
            <ui:Button Content="Сохранить" Appearance="Primary" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
