<Window x:Class="ASimpleCalendar.Widgets.ClockWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="250"
        Height="130"
        WindowStartupLocation="Manual">
    <Border CornerRadius="14"
            Background="#E01C1C1C"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid>
            <Button Content="×"
                    Width="26"
                    Height="26"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,8,8,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#CCFFFFFF"
                    FontSize="14"
                    Cursor="Hand"
                    Click="Close_Click" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,8,0,0">
                <TextBlock x:Name="TimeText"
                           FontSize="36"
                           FontWeight="Light"
                           Foreground="White"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="DateText"
                           FontSize="13"
                           Foreground="#99FFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
